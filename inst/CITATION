    textVersion = paste0(
      "Thomas, R.G. (2026). ",
      "zzedc: Electronic Data Capture System for Clinical Trials. ",
      if (nzchar(pkg_ver)) paste0("R package version ", pkg_ver, ". "),
      "https://github.com/rgt47/zzedc"
